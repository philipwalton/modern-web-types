+// These elements redeclare HTMLElement's cancel and error handlers with a
+// narrower receiver. WebRef also identifies both events as DOMException.
+// Inherit the handlers and event-map entries from GlobalEventHandlers.
+removals {
+  interface HTMLCameraElement {
+    property oncancel
+    property onerror
+  }
+  interface HTMLMicrophoneElement {
+    property oncancel
+    property onerror
+  }
+  interface HTMLUserMediaElement {
+    property oncancel
+    property onerror
+  }
+}
